      "Bash(hdiutil *)",
      "Bash(mkfs*)",
      "Bash(newfs*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git tag *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(git push *--delete*)",
