      "Bash(cargo build *)",
      "Bash(pytest *)",
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws * get-*)",
      "Bash(aws s3 ls *)",
      "Bash(gcloud * list)",
      "Bash(gcloud * list *)",
      "Bash(gcloud * describe *)",
      "Bash(gcloud logging read *)",
      "Bash(gcloud config get-value *)",
      "Bash(terraform version *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)"
