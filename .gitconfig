[pull]
  rebase = true

[user]
  name = troy.schneringer
  email = troy.schneringer@gmail.com
	signingkey = /Users/troyschneringer/.ssh/id_ed25519_signing.pub

[core]
  editor = nano

[color]
  ui = true

[fetch]
  prune = true  

[push]
  default = current

[alias]
  amend = commit --amend --no-edit
  pr = "!f() { \
          git checkout -b $1 && git commit --allow-empty -m 'create branch' && gh pr create --draft --title \"$2\" --body '// TODO'; \
        }; f"
[branch]
	autoSetupMerge = simple
[gpg]
	format = ssh
